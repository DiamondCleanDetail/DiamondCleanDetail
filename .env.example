# Copy this file to .env.local and fill in real values.
# .env.local is gitignored — never commit real keys.

# Supabase — Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Stripe — Developers > API keys (Test mode)
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
STRIPE_SECRET_KEY=

# "Coming soon" preview gate — shows /coming-soon to visitors until this is
# flipped off. Set SITE_GATE_ENABLED=false (in Vercel too) to fully disable
# once Stripe/Clerk are ready and the site is meant to go public.
SITE_GATE_ENABLED=true
SITE_UNLOCK_PASSPHRASE=

# Google reviews — optional. With both set, the reviews block on the homepage
# pulls the live rating, review count and up to 5 review quotes from the
# Google listing once a day. Leave blank and it uses the hand-entered list in
# src/data/testimonials.ts instead, exactly as before.
#
# Key: Google Cloud console > APIs & Services > Credentials, with the
#   "Places API (New)" enabled and billing on. Restrict it to the Places API.
# Place ID: GOOGLE_PLACES_API_KEY=... node scripts/find-place-id.mjs
GOOGLE_PLACES_API_KEY=
GOOGLE_PLACE_ID=

# Google Analytics 4 — optional. Set to your Measurement ID (looks like
# G-XXXXXXXXXX) and Google Analytics loads on every page and tracks route
# changes automatically. Leave blank and no analytics script loads at all.
#
# Get the ID: analytics.google.com > Admin > Data Streams > your web stream >
#   "Measurement ID" (top right). Create a GA4 property + web stream first if
#   you don't have one.
# Set it in Vercel (Production) to count real visitors. Adding it here in
# .env.local as well will also count your local dev traffic, so usually leave
# this blank locally.
NEXT_PUBLIC_GA_ID=
